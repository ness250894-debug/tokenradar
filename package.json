{
  "name": "tokenradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['out','.next']) fs.rmSync(p,{recursive:true,force:true});\"",
    "consolidate": "tsx scripts/consolidate-data.ts",
    "prebuild": "tsx scripts/validate-env.ts && tsx scripts/compute-search-intent.ts && npm run consolidate && tsx scripts/validate-content.ts && tsx scripts/generate-og-images.tsx && tsx scripts/generate-sitemap.ts",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "analytics:auth": "tsx scripts/export-engagement-baseline.ts --auth",
    "analytics:baseline": "tsx scripts/export-engagement-baseline.ts",
    "analytics:summary": "tsx scripts/summarize-engagement-baseline.ts",
    "d1:backfill-social": "tsx scripts/backfill-social-ledger.ts",
    "d1:migrate": "tsx scripts/d1-migrate.ts",
    "d1:report": "tsx scripts/report-ops-ledger.ts",
    "d1:smoke": "tsx scripts/d1-smoke.ts",
    "deploy:check-files": "tsx scripts/check-pages-file-budget.ts out",
    "cf:usage-snapshot": "tsx scripts/snapshot-cloudflare-usage.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lighthouse:ci": "npx --yes @lhci/cli@0.15.1 autorun",
    "pagespeed:snapshot": "tsx scripts/pagespeed-snapshot.ts",
    "r2:cleanup-ledger": "tsx scripts/cleanup-r2-staging.ts",
    "studio": "remotion studio src/video/Root.tsx"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@coingecko/coingecko-typescript": "^5.1.1",
    "@next/third-parties": "^16.2.6",
    "@remotion/cli": "^4.0.462",
    "@remotion/google-fonts": "^4.0.462",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@xdevplatform/xdk": "^0.5.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "grammy": "^1.43.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "next": "^16.2.6",
    "next-nprogress-bar": "^2.4.7",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remotion": "^4.0.462",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.3.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "satori": "^0.26.0",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  }
}
