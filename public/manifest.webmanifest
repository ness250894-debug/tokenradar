{
  "id": "/",
  "name": "TokenRadar",
  "short_name": "TokenRadar",
  "description": "Crypto token research, risk scores, launch watchlists, and market intelligence.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#07080B",
  "theme_color": "#07080B",
  "categories": ["finance", "news", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Tracked Tokens",
      "short_name": "Tokens",
      "description": "Open the TokenRadar token directory.",
      "url": "/tokens",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Local Watchlist",
      "short_name": "Saved",
      "description": "Open saved tokens on this device.",
      "url": "/watchlist",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Launch Watchlist",
      "short_name": "Upcoming",
      "description": "Open the TokenRadar launch watchlist.",
      "url": "/upcoming",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Learn",
      "short_name": "Learn",
      "description": "Open TokenRadar learning resources.",
      "url": "/learn",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
