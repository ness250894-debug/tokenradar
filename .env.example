# ============================================
# TokenRadar.co — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.

# CoinGecko (optional — free tier works without key)
COINGECKO_API_KEY=


# Claude AI — Required for content generation
ANTHROPIC_API_KEY=

# Gemini AI — Used for social summaries (Free tier)
GEMINI_API_KEY=
# Disable Gemini 2.5 hidden thinking by default for short publishing tasks.
# Set to -1 for dynamic thinking or a positive token budget for harder prompts.
GEMINI_THINKING_BUDGET=0
# Optional: set true to disable provider prompt/context caching.
AI_PROMPT_CACHE_DISABLED=false
# Social Media — X (Twitter) OAuth 2.0 — run `npx tsx scripts/generate-x-token.ts` to obtain
X_OAUTH2_CLIENT_ID=
# Optional for confidential-client apps; leave blank for PKCE public-client flows.
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_REFRESH_TOKEN=
X_BEARER_TOKEN=

# Social Media — Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Public username used by the read-only Telegram view collector (without @).
TELEGRAM_CHANNEL_USERNAME=Token_Radar_Official

# Deployment — Cloudflare Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Cloudflare D1 — Ops ledger for automation/R2 state
D1_DATABASE_ID=
# Optional: set true to disable best-effort D1 ledger writes without removing credentials.
D1_OPS_LEDGER_DISABLED=false
# Optional: default is 48 hours.
D1_MEDIA_STAGING_TTL_HOURS=48

# Minimum token count required before a category gets its own static /category page.
# Raising this keeps Cloudflare Pages file count safely under the Free plan cap.
STATIC_CATEGORY_MIN_TOKENS=10

# Fail deploy verification before Cloudflare Pages Free's 20,000-file hard cap.
CF_PAGES_FILE_BUDGET=19000

# GitHub (Required to automatically rotate X OAuth secrets in GitHub Actions)
GH_PAT=

# SEO — IndexNow (must match the key filename in public/)
INDEXNOW_KEY=

# Error Reporting & Monitoring — Telegram (separate bot for ops alerts)
# Also receives TikTok manual packages and inbox-upload captions.
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=


# Public — Exposed to browser
NEXT_PUBLIC_SITE_URL=https://tokenradar.co
NEXT_PUBLIC_SITE_NAME=TokenRadar
# Blank uses the Formspree endpoint configured in src/lib/config.ts.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
# Optional Cloudflare Web Analytics manual beacon token.
# Leave blank if Cloudflare Pages dashboard auto-injection is enabled.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Sentry error monitoring (Developer plan friendly defaults in code).
# Required to send browser errors. Blank disables Sentry initialization.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server/edge DSN fallback. Usually leave blank and use the public DSN above.
SENTRY_DSN=
# Optional overrides. Blank = enabled only in production, environment inferred from deploy/NODE_ENV.
NEXT_PUBLIC_SENTRY_ENABLED=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ERROR_SAMPLE_RATE=
# Optional source map upload. Leave blank to avoid Sentry build-time uploads.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Local diagnostics
DEBUG_CONTENT_LOADER=false
TOKENRADAR_ALLOWED_OUTBOUND_HOSTS=

# Social Media — Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:tokenradar.co
PAGESPEED_API_KEY=
# GA4/GSC baseline export. Preferred when service-account access cannot be added in Google UI:
# 1. Create a Google OAuth Desktop client in the same Google Cloud project.
# 2. Fill GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET.
# 3. Run `npm run analytics:auth` once with a Google account that owns GA4/GSC.
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_PATH=data/analytics/google-oauth-token.json
GOOGLE_OAUTH_INTERACTIVE=0
# Optional fallback for scripts that read GA4/GSC. Supports raw service-account JSON or base64-encoded JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Social Media — YouTube Shorts Automation
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional public-statistics credential used by the social metrics collector.
YOUTUBE_API_KEY=
REMOTION_CONCURRENCY=

# Optional stock media enrichment for Remotion videos.
# Run `npm run video:assets -- --max 6` to populate public/video-assets/broll/manifest.json.
VIDEO_ASSET_PROVIDERS=pexels,pixabay
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional local Blender binary for generated 3D b-roll loops.
# Run `npm run video:blender -- --preset all` to populate reusable generated loops.
BLENDER_BIN=blender

# Social Media - TikTok (publishing remains unscheduled until API audit/relaunch approval)
# Historical metrics require a creator token with video.list. Content Posting API
# scopes are used only for explicit, operator-approved sandbox/direct-post tests.
# TIKTOK_ENV=sandbox uses video.upload; production uses video.publish.
TIKTOK_ENV=sandbox
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://tokenradar.co/tiktok/callback
TIKTOK_REFRESH_TOKEN=
# Fallback only; the metrics collector prefers complete refresh credentials.
TIKTOK_ACCESS_TOKEN=
TIKTOK_LAST_PUBLISH_ID=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_UPLOAD_CHUNK_SIZE_BYTES=10485760
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_STITCH=false
TIKTOK_BRAND_CONTENT_TOGGLE=false
TIKTOK_BRAND_ORGANIC_TOGGLE=false
TIKTOK_IS_AIGC=true

# ── Cloudflare R2 (Media Staging for Meta API) ──
R2_ACCOUNT_ID=
# Optional account-wide telemetry token. Grant only Workers R2 Storage Read.
CLOUDFLARE_R2_METRICS_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tokenradar-media
R2_PUBLIC_URL=https://media.tokenradar.co

# ── Instagram (Graph API) ──
# facebook_login: Page/System User token on graph.facebook.com (default)
# instagram_login: renewable Instagram User token on graph.instagram.com
IG_AUTH_MODE=facebook_login
META_APP_ID=
META_APP_SECRET=
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# ── Threads API ──
THREADS_ACCESS_TOKEN=
THREADS_ACCOUNT_ID=
# Optional when Threads uses a separate Meta app; otherwise META_APP_* is reused.
THREADS_APP_ID=
THREADS_APP_SECRET=
