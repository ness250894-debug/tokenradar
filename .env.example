# ============================================
# TokenRadar.co — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.

# CoinGecko (optional — free tier works without key)
COINGECKO_API_KEY=


# Claude AI — Required for content generation
ANTHROPIC_API_KEY=

# Gemini AI — Used for social summaries (Free tier)
GEMINI_API_KEY=
# Social Media — X (Twitter) OAuth 2.0 — run `npx tsx scripts/generate-x-token.ts` to obtain
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_REFRESH_TOKEN=
X_BEARER_TOKEN=

# Social Media — Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Deployment — Cloudflare Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# GitHub (Required to automatically rotate X OAuth secrets in GitHub Actions)
GH_PAT=

# SEO — IndexNow (must match the key filename in public/)
INDEXNOW_KEY=

# Error Reporting & Monitoring — Telegram (separate bot for ops alerts)
# Also receives TikTok manual video packages while API approval is pending.
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=


# Public — Exposed to browser
NEXT_PUBLIC_SITE_URL=https://tokenradar.co
NEXT_PUBLIC_SITE_NAME=TokenRadar
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Social Media — Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Social Media — YouTube Shorts Automation
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Cloudflare R2 (Media Staging for Meta API) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tokenradar-media
R2_PUBLIC_URL=https://media.tokenradar.co

# ── Instagram (Graph API) ──
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# ── Threads API ──
THREADS_ACCESS_TOKEN=
THREADS_ACCOUNT_ID=
